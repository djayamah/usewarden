{
  "name": "usewarden",
  "version": "0.1.0",
  "description": "Stop your AI coding agent before it touches something it shouldn't. A local guardrail for Claude Code, Cursor, Gemini CLI and more: blocks out-of-scope writes, .env reads, rm -rf and force pushes, with no API key and zero tokens.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "usewarden": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist/src",
    "assets",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const f='dist/src/cli.js';require('fs').chmodSync(f,0o755);\"",
    "test": "node --test --test-timeout=120000 \"dist/tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run build && npm test"
  },
  "keywords": [
    "ai-agent-safety",
    "agent-guardrails",
    "llm-guardrails",
    "ai-code-review",
    "claude-code",
    "claude-code-hooks",
    "cursor",
    "gemini-cli",
    "github-copilot-cli",
    "codex-cli",
    "prevent-rm-rf",
    "dotenv-protection",
    "secret-scanning",
    "prompt-injection",
    "agent-drift",
    "context-rot",
    "developer-tools",
    "cli",
    "security",
    "devsecops"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djayamah/usewarden.git"
  },
  "homepage": "https://github.com/djayamah/usewarden#readme",
  "bugs": {
    "url": "https://github.com/djayamah/usewarden/issues"
  }
}
