{
  "name": "usewarden",
  "version": "0.1.0",
  "description": "Stop your AI coding agent before it touches something it shouldn't. A local guardrail for Claude Code, Cursor, Gemini CLI and more: blocks out-of-scope writes, .env reads, rm -rf and force pushes, with no API key and zero tokens.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "usewarden": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist/src",
    "assets",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=120000 \"dist/tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run build && npm test"
  },
  "keywords": [
    "ai",
    "agent",
    "security",
    "guardrails",
    "hooks",
    "claude-code",
    "cursor",
    "gemini-cli"
  ],
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djayamah/usewarden.git"
  },
  "homepage": "https://github.com/djayamah/usewarden#readme",
  "bugs": {
    "url": "https://github.com/djayamah/usewarden/issues"
  }
}
