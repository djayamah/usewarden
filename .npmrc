# ChainDrop hardening (2026-08-04). UNITS ARE DAYS, not minutes - verified empirically,
# see DECISIONS.md D-009. Requires npm >= 11.10.0.
# See docs/THREAT-MODEL.md T-01/T-02 and launch/PUBLISH-CHECKLIST.md.
min-release-age=7
audit=true
fund=false

# INSTALL-TIME SOURCE CONTROLS (npm >= 11.15.0, shipped 2026-05-22).
#
# Each of these says "a dependency may NOT come from here". The default for all four is `all`,
# and `--allow-git` is documented as flipping to `none` by default in npm v12 - these lines make
# that posture explicit and current rather than waiting for it.
#
# usewarden has ZERO runtime dependencies and two devDependencies, both from the registry, so
# nothing legitimate is refused: `npm ci --ignore-scripts` was run against this exact file and
# resolved 3 packages, exit 0. A dependency that suddenly needs one of these is the signal, not
# an inconvenience.
#
# Older npm ignores unknown config keys, so this file stays safe on npm < 11.15.0 - it simply
# provides no protection there, which is why scripts/verify-hardening.sh reports the CLI version.
allow-file=none
allow-remote=none
allow-git=none

# `allow-directory` is deliberately LEFT AT THE DEFAULT, and this is not an oversight.
#
# Setting it to `none` breaks `npm pack`, which is how this package is built and published:
#
#     $ npm pack --dry-run --allow-directory=none
#     npm error code EALLOWDIRECTORY
#     npm error Fetching packages of type "directory" have been disabled
#
# Packing the working directory is itself a "directory" fetch, so the control that forbids
# directory dependencies also forbids building the release. Measured here on npm 11.19.0, one
# control at a time: file, remote and git are all safe (exit 0); directory is the only one that
# fails. It was caught by `scripts/pre-publish-check.sh` reporting COULD NOT VERIFY rather than
# passing, which is the behaviour that gate was written for.
#
# usewarden has no directory dependencies for this to protect against anyway - `npm ls
# --omit=dev` is empty - so the control would have bought nothing and cost the release.
